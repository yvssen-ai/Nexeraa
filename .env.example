# Optional. Any endpoint that accepts a POST of FormData — Formspree, Basin,
# a Next.js route handler, etc. Without it the contact form validates and then
# hands off to the visitor's mail client.
NEXT_PUBLIC_FORM_ENDPOINT=

# Absolute site URL used for canonical + Open Graph tags. On Vercel this is
# derived from the project's production domain automatically; set it here once
# a custom domain is live so link previews resolve against the real host.
NEXT_PUBLIC_SITE_URL=
